# Кастомный Triton образ с NeMo для Python Backend
FROM nvcr.io/nvidia/tritonserver:24.07-py3

# Устанавливаем PyTorch и NeMo
RUN pip install --no-cache-dir \
    torch>=2.3.0 \
    nemo-toolkit[asr]==2.5.3 \
    omegaconf>=2.3.0 \
    hydra-core>=1.3.0 \
    scipy>=1.10.0

# Копируем model repository
COPY model_repository /models

EXPOSE 8000 8001 8002

CMD ["tritonserver", "--model-repository=/models", "--strict-model-config=false", "--log-verbose=1", "--backend-config=python,shm-default-byte-size=67108864"]

