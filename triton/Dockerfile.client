FROM python:3.11-slim

RUN apt-get update && apt-get install -y \
    build-essential \
    portaudio19-dev \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies
RUN pip install --no-cache-dir \
    tritonclient[grpc]>=2.40.0 \
    numpy>=1.24.0 \
    soundfile>=0.12.0 \
    pyaudio>=0.2.14

COPY client.py .

ENTRYPOINT ["python", "client.py"]

